rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidProject(data, userId) {
      return data.keys().hasAll([
          'userId', 'title', 'description', 'category', 'modelId',
          'systemInstruction', 'temperature', 'topP', 'topK', 'maxOutputTokens',
          'jsonModeEnabled', 'jsonSchema', 'safetyBalanced', 'pinned',
          'messageCount', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'title', 'description', 'category', 'modelId',
          'systemInstruction', 'temperature', 'topP', 'topK', 'maxOutputTokens',
          'jsonModeEnabled', 'jsonSchema', 'safetyBalanced', 'pinned',
          'messageCount', 'createdAt', 'updatedAt'
        ]) &&
        data.userId == userId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.description is string && data.description.size() <= 500 &&
        data.category in ['CHAT', 'STRUCTURED', 'VISION', 'CODE'] &&
        data.modelId in ['gemini-3.8-flash', 'gemini-4-argon', 'gemini-3.5-flash-lite'] &&
        data.systemInstruction is string && data.systemInstruction.size() <= 12000 &&
        data.temperature is number && data.temperature >= 0.0 && data.temperature <= 2.0 &&
        data.topP is number && data.topP >= 0.05 && data.topP <= 1.0 &&
        data.topK is int && data.topK >= 1 && data.topK <= 100 &&
        data.maxOutputTokens is int && data.maxOutputTokens >= 256 && data.maxOutputTokens <= 8192 &&
        data.jsonModeEnabled is bool &&
        data.jsonSchema is string && data.jsonSchema.size() <= 12000 &&
        data.safetyBalanced is bool &&
        data.pinned is bool &&
        data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 100000 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMessage(data, userId, projectId) {
      return data.keys().hasAll([
          'userId', 'projectId', 'role', 'content', 'modelId',
          'estimatedTokens', 'hasImageAttachment', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'projectId', 'role', 'content', 'modelId',
          'estimatedTokens', 'hasImageAttachment', 'createdAt'
        ]) &&
        data.userId == userId &&
        data.projectId == projectId &&
        data.role in ['user', 'model'] &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 60000 &&
        data.modelId is string && data.modelId.size() >= 1 && data.modelId.size() <= 64 &&
        data.estimatedTokens is int && data.estimatedTokens >= 0 && data.estimatedTokens <= 2000000 &&
        data.hasImageAttachment is bool &&
        data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidExportRecord(data, userId) {
      return data.keys().hasAll([
          'userId', 'projectTitle', 'exportType', 'packageName',
          'fileName', 'sizeBytes', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'projectTitle', 'exportType', 'packageName',
          'fileName', 'sizeBytes', 'createdAt'
        ]) &&
        data.userId == userId &&
        data.projectTitle is string && data.projectTitle.size() >= 1 && data.projectTitle.size() <= 140 &&
        data.exportType in ['ANDROID_PROJECT_ZIP', 'INSTALLED_APK', 'WORKSPACE_BACKUP'] &&
        data.packageName is string && data.packageName.size() >= 1 && data.packageName.size() <= 160 &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 160 &&
        data.sizeBytes is int && data.sizeBytes >= 0 && data.sizeBytes <= 536870912 &&
        data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /users/{userId}/projects/{projectId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(projectId);

      allow create: if isOwner(userId) &&
        isValidId(projectId) &&
        isValidProject(incoming(), userId);

      allow update: if isOwner(userId) &&
        isValidId(projectId) &&
        isValidProject(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        (
          // Action 1: Update prompt settings, metadata, or system instruction
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'category', 'modelId',
            'systemInstruction', 'temperature', 'topP', 'topK',
            'maxOutputTokens', 'jsonModeEnabled', 'jsonSchema',
            'safetyBalanced', 'pinned', 'updatedAt'
          ]) ||
          // Action 2: Toggle pin state
          incoming().diff(existing()).affectedKeys().hasOnly(['pinned', 'updatedAt']) ||
          // Action 3: Update message counter on send/clear/delete
          incoming().diff(existing()).affectedKeys().hasOnly(['messageCount', 'updatedAt'])
        );

      allow delete: if isOwner(userId) && isValidId(projectId);

      match /messages/{messageId} {
        allow list: if isOwner(userId) && isValidId(projectId);
        allow get: if isOwner(userId) && isValidId(projectId) && isValidId(messageId);

        allow create: if isOwner(userId) &&
          isValidId(projectId) &&
          isValidId(messageId) &&
          isValidMessage(incoming(), userId, projectId) &&
          exists(/databases/$(database)/documents/users/$(userId)/projects/$(projectId));

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(projectId) && isValidId(messageId);
      }
    }

    match /users/{userId}/exports/{exportId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(exportId);

      allow create: if isOwner(userId) &&
        isValidId(exportId) &&
        isValidExportRecord(incoming(), userId);

      allow update: if false;
      allow delete: if isOwner(userId) && isValidId(exportId);
    }
  }
}
